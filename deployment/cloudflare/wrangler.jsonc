{
  "name": "worldkinetics-placeholder",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "worldkinetics.app",
      "custom_domain": true
    }
  ],
  "main": "worker.mjs"
}
