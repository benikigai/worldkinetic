# Export settings in the server shell. This file is not loaded automatically.
PORT=4310
# Use a fresh v2 runtime. Legacy v1 snapshots are never migrated or replaced.
WORLDKINETICS_RUNTIME_DIR=.runtime/backend-v2-4310
# Supply through the existing secret-management workflow; never expose in the browser.
# Product endpoint: POST https://api.openai.com/v1/responses, model gpt-6-astra.
OPENAI_API_KEY=
# Optional legacy probe only: npm run verify:astra. Product runtime uses Responses.
WORLDKINETICS_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# Current product slice: numeric resize from baseline_50 before acceptance only.
